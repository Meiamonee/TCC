# backend/.env da VM (Oracle). Copiado pelo instalar.sh; preencha antes de rodar de novo.

# String de conexao do MongoDB Atlas (Database > Connect > Drivers). Coloque o nome do banco
# antes do "?", ex.: ...mongodb.net/Mercados?retryWrites=true&w=majority
MONGODB_URI=

# Endereco do site no Cloudflare Pages (pode ter mais de um, separados por virgula).
CORS_ORIGIN=https://superpreco.pages.dev

# Token secreto para disparar a coleta pela API (POST /api/scraping/atualizar).
# Gere um com: openssl rand -hex 24
ADMIN_TOKEN=

PORT=3001

# Coleta automatica (horario de Brasilia).
SCRAPER_CRON=0 6,18 * * *
SCRAPER_PAGE_DELAY_MS=1000
SCRAPER_PAGE_DELAY_JITTER_MS=1000

# Chromium e ChromeDriver instalados pelo instalar.sh.
CHROME_BINARY_PATH=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver

# A VM fica atras do Caddy (1 proxy).
TRUST_PROXY=1
