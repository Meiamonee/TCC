# O Caddy recebe as requisicoes em HTTPS (certificado gratuito do Let's Encrypt, automatico)
# e repassa para a API na porta 3001. __DOMINIO__ e trocado pelo instalar.sh por um nome
# do sslip.io que aponta para o IP da VM (ex.: api.150-230-1-2.sslip.io), sem precisar comprar dominio.
__DOMINIO__ {
    encode gzip
    reverse_proxy localhost:3001
}
