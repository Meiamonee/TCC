MONGODB_URI=mongodb://localhost:27017/Mercados

# Obrigatoria para iniciar uma coleta pela API. Use pelo menos 32 bytes aleatorios.
ADMIN_API_KEY=substitua-por-uma-chave-aleatoria-longa

# Origens do frontend autorizadas, separadas por virgula.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# O scheduler inicia junto com o backend. Defina false apenas para manutencao.
SCHEDULER_ENABLED=true
COLLECTION_CRON=0 6,18 * * *
COLLECTION_TIMEZONE=America/Sao_Paulo

# Limites por IP em uma janela de 15 minutos.
API_RATE_LIMIT=600
ADMIN_RATE_LIMIT=10

# Configure quando o backend estiver atras de um proxy reverso conhecido.
# TRUST_PROXY=1

# Opcional: defina se o Selenium nao encontrar o Chrome/ChromeDriver sozinho.
# CHROME_BINARY_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROMEDRIVER_PATH=C:\caminho\para\chromedriver.exe

# Somente novas tentativas apos erro aguardam um intervalo curto.
SCRAPER_RETRY_DELAY_MS=5000
