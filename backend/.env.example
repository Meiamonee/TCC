MONGODB_URI=mongodb://localhost:27017/Mercados

# Pausa entre paginas do scraper (base + variacao aleatoria), em milissegundos.
SCRAPER_PAGE_DELAY_MS=0
SCRAPER_PAGE_DELAY_JITTER_MS=0

# Coleta automatica junto com a API (formato cron, horario de Brasilia).
# SCHEDULER_ENABLED=false
# SCRAPER_CRON=0 6,18 * * *

# Token exigido para disparar a coleta pela API (POST /api/scraping/atualizar).
# ADMIN_TOKEN=troque-por-um-valor-secreto

# Opcional: defina se o Selenium nao encontrar o Chrome/ChromeDriver sozinho.
# CHROME_BINARY_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROMEDRIVER_PATH=C:\caminho\para\chromedriver.exe
